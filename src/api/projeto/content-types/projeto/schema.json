{
  "kind": "collectionType",
  "collectionName": "projetos",
  "info": {
    "singularName": "projeto",
    "pluralName": "projetos",
    "displayName": "Projeto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "resumo": {
      "type": "text"
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "categoriaPrincipal": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::categorias-de-projeto.categorias-de-projeto",
      "mappedBy": "projeto"
    },
    "categorias_de_projetos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::categorias-de-projeto.categorias-de-projeto",
      "inversedBy": "projetos"
    },
    "tecnologias": {
      "type": "component",
      "component": "shared.tecnologia",
      "repeatable": true
    },
    "problemaResolvido": {
      "type": "text",
      "required": true
    },
    "funcionalidades": {
      "type": "component",
      "component": "shared.funcionalidade-do-projeto",
      "repeatable": true
    },
    "minhaParticipacao": {
      "type": "text",
      "required": true
    },
    "urlDemo": {
      "type": "string"
    },
    "urlCodigo": {
      "type": "string"
    },
    "destaque": {
      "type": "boolean"
    },
    "ordem": {
      "type": "integer"
    },
    "labelButton": {
      "type": "string"
    }
  }
}
