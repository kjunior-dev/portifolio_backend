HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Use this locally when your shell has Railway's private DATABASE_URL exported.
# Copy the Railway public TCP proxy connection string here.
DATABASE_PUBLIC_URL=postgresql://user:password@host.proxy.rlwy.net:port/railway
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SCHEMA=public

# Email SMTP provider
# For Gmail, use an App Password instead of your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=webdevcv.cv@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_DEFAULT_FROM=webdevcv.cv@gmail.com
SMTP_DEFAULT_REPLY_TO=webdevcv.cv@gmail.com
SMTP_TEST_ADDRESS=webdevcv.cv@gmail.com
